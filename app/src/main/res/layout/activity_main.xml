<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/md_primary_bar"
        app:titleTextColor="@android:color/white" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="10dp">

                    <LinearLayout
                        android:id="@+id/tile_macros"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_macros">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_macros" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_macros" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_add_macro"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_add_macro">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_add" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_add_macro" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_action_blocks"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_action_blocks">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_blocks" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_action_blocks" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_stopwatches"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_stopwatches">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_timer" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_stopwatches" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_system_log"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_system_log">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_log" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_system_log" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_videos"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_videos">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_video" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_videos" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_last_macro"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_last_macro">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_last" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_last_macro" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_favourites"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_favourites">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_favourite" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_favourites" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_geofences"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_geofences">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_geofence" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_geofences" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_cell_towers"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_cell_towers">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_tower" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_cell_towers" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_plugins"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_plugins">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_plugin" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_plugins" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tile_quick_run"
                        style="@style/Widget.AutoDroid.HomeTile"
                        android:layout_width="0dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="6dp"
                        android:background="@drawable/tile_quick_run">

                        <ImageView
                            style="@style/Widget.AutoDroid.HomeTileIcon"
                            android:src="@drawable/ic_tile_run" />

                        <TextView
                            style="@style/Widget.AutoDroid.HomeTileLabel"
                            android:text="@string/tile_quick_run" />
                    </LinearLayout>
                </GridLayout>

                <TextView
                    android:id="@+id/macros_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="16dp"
                    android:textColor="@color/md_text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/macros_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/md_list_background"
            android:orientation="vertical"
            android:visibility="gone">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatCheckedTextView
                        android:id="@+id/filter_favourites"
                        style="@style/Widget.AutoDroid.FilterChip"
                        android:text="@string/filter_favourites" />

                    <androidx.appcompat.widget.AppCompatCheckedTextView
                        android:id="@+id/filter_all"
                        style="@style/Widget.AutoDroid.FilterChip"
                        android:checked="true"
                        android:text="@string/filter_all" />

                    <androidx.appcompat.widget.AppCompatCheckedTextView
                        android:id="@+id/filter_enabled"
                        style="@style/Widget.AutoDroid.FilterChip"
                        android:layout_marginStart="6dp"
                        android:text="@string/filter_enabled" />

                    <androidx.appcompat.widget.AppCompatCheckedTextView
                        android:id="@+id/filter_disabled"
                        style="@style/Widget.AutoDroid.FilterChip"
                        android:layout_marginStart="6dp"
                        android:text="@string/filter_disabled" />

                    <androidx.appcompat.widget.AppCompatCheckedTextView
                        android:id="@+id/filter_errors"
                        style="@style/Widget.AutoDroid.FilterChip"
                        android:layout_marginStart="6dp"
                        android:text="@string/filter_errors" />

                    <androidx.appcompat.widget.AppCompatCheckedTextView
                        android:id="@+id/filter_running"
                        style="@style/Widget.AutoDroid.FilterChip"
                        android:layout_marginStart="6dp"
                        android:text="@string/filter_running" />
                </LinearLayout>
            </HorizontalScrollView>

            <ListView
                android:id="@+id/list_rules"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:divider="@null"
                android:paddingBottom="80dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:id="@+id/rules_empty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:drawableTop="@drawable/rules_empty_icon"
                android:drawablePadding="18dp"
                android:text="@string/rules_empty"
                android:textColor="@color/md_empty_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/templates_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/templates_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/templates_empty"
                android:textColor="@color/md_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/settings_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/md_text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:contentDescription="@string/action_add"
        android:src="@drawable/ic_tile_add"
        app:backgroundTint="@color/md_tile_add_macro"
        app:tint="@android:color/white" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:background="@color/md_primary_bar"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_bottom_nav" />
</LinearLayout>
